{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceGivenPacket",
  "type": "object",
  "required": ["claim", "category", "sources", "passages"],
  "additionalProperties": false,
  "properties": {
    "claim_id": { "type": "string" },
    "claim": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["factual", "opinion", "prediction", "needs_context"]
    },
    "claim_date": { "type": ["string", "null"] },
    "evidence_as_of": { "type": ["string", "null"] },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "passages": {
      "type": "array",
      "items": { "$ref": "#/$defs/passage" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "canonical_url", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "canonical_url": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "published_at": { "type": ["string", "null"] },
        "retrieved_at": { "type": ["string", "null"] },
        "extraction_status": { "type": "string", "enum": ["ok"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "passage": {
      "type": "object",
      "required": ["id", "source_id", "quote"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "start_offset": { "type": "integer", "minimum": 0 },
        "end_offset": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
